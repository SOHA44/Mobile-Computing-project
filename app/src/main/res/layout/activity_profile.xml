<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="183dp"
        android:background="#E6315B8A"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:textAlignment="center">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/UserImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />


        <LinearLayout
            android:layout_width="238dp"
            android:layout_height="128dp"
            android:layout_marginLeft="130dp"
            android:layout_marginTop="-100dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/tvProfName"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="XXXXX YYYYY"
                android:textColor="#E9EAEF"

                android:textSize="22dp" />

            <TextView
                android:id="@+id/tvProfEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Email"
                android:textColor="#FCC3C8D5"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/tvProfFaculty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:text="Faculty"
                android:textColor="#FCC3C8D5"
                android:textSize="14dp" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="vertical"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            >

            <TextView
                android:id="@+id/textView5"
                android:layout_width="204dp"
                android:layout_height="35dp"
                android:layout_weight="3"
                android:fontFamily="sans-serif-medium"
                android:text="Items"
                android:paddingLeft="15dp"

                android:textSize="18dp" />

            <Button
                android:id="@+id/btn_view_all_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#03FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:paddingRight="0dp"
                android:text="View All  ›"
                android:textColor="#5C8DBD"
                android:textSize="12dp" />


        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="65dp">

            <TextView
                android:id="@+id/textView10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:text="🔍"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="37dp"


                android:layout_toEndOf="@+id/textView10"
                android:text="My Lost Items"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="17dp"
                android:layout_toEndOf="@+id/textView10"
                android:text="View and manage your lost items"
                android:textColor="#B1A8A8"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btn_view_lost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentEnd="true"


                android:layout_alignParentBottom="true"
                android:layout_marginEnd="1dp"

                android:backgroundTint="#03FFFFFF"
                android:fontFamily="monospace"
                android:text="›"
                android:textColor="#454242"
                android:textSize="43dp" />


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="65dp">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:text="📦"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="38dp"


                android:layout_toEndOf="@+id/textView12"
                android:text="My Found Items"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="18dp"
                android:layout_toEndOf="@+id/textView12"
                android:text="View and manage your found items"
                android:textColor="#B1A8A8"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btn_view_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="300dp"

                android:layout_marginEnd="2dp"

                android:backgroundTint="#03FFFFFF"
                android:fontFamily="monospace"
                android:text="›"
                android:textColor="#454242"
                android:textSize="43dp" />


        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"


        android:background="#E0E0E0" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="171dp"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="37dp"

            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView15"
                android:layout_width="204dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="15dp"
                android:paddingTop="15dp"
                android:text="Claims"
                android:textSize="18dp" />


        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="65dp">

            <TextView
                android:id="@+id/textView16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:text="📋"

                android:textSize="25sp" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="37dp"


                android:layout_toEndOf="@+id/textView16"
                android:text="Add a claim"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:layout_toEndOf="@+id/textView16"
                android:text="If you believe an item belongs to you select it"
                android:textColor="#B1A8A8"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btnAddClaim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentEnd="true"


                android:layout_alignParentBottom="true"
                android:layout_marginEnd="0dp"

                android:layout_marginBottom="3dp"
                android:backgroundTint="#03FFFFFF"
                android:fontFamily="monospace"
                android:text="›"
                android:textColor="#454242"
                android:textSize="43dp" />


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="65dp">

            <TextView
                android:id="@+id/textView19"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:text="📨"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/textView20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="38dp"


                android:layout_toEndOf="@+id/textView19"
                android:text="Recieved Claims"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/textView21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="18dp"
                android:layout_toEndOf="@+id/textView19"
                android:text="Show and manage all recieved claims"
                android:textColor="#B1A8A8"
                android:textSize="12dp" />

            <Button
                android:id="@+id/btnRecievedClaims"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="300dp"

                android:layout_marginEnd="2dp"

                android:backgroundTint="#03FFFFFF"
                android:fontFamily="monospace"
                android:text="›"
                android:textColor="#454242"
                android:textSize="43dp" />


        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"


        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="-20dp"
        android:gravity="center"


        >

        <RelativeLayout
            android:id="@+id/notificationsProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="-20dp"
            >

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="13dp"
                app:srcCompat="@drawable/ic_notification" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentBottom="true"
                android:layout_marginStart="35dp"
                android:layout_marginRight="-4dp"
                android:layout_marginBottom="13dp"
                android:layout_toEndOf="@+id/imageView2"
                android:text="Notifications"
                android:textSize="18dp" />
            />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/updateProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="13dp"
                app:srcCompat="@drawable/baseline_drive_file_rename_outline_24" />

            <TextView
                android:id="@+id/textView22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentBottom="true"
                android:layout_marginStart="35dp"
                android:layout_marginRight="-4dp"
                android:layout_marginBottom="14dp"
                android:layout_toEndOf="@+id/imageView3"
                android:text="Update profile"
                android:textSize="18dp" />
            />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/signOutProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="4dp"
                app:srcCompat="@drawable/images__3__removebg_preview" />

            <TextView
                android:id="@+id/textView23"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentBottom="true"
                android:layout_marginStart="35dp"
                android:layout_marginRight="-4dp"
                android:layout_marginBottom="18dp"
                android:layout_toEndOf="@+id/imageView4"
                android:text="Sign out"
                android:textSize="18dp" />
            />
        </RelativeLayout>

    </LinearLayout>


</LinearLayout>