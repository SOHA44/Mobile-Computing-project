```xml
    <?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
   android:background="@color/white"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- ASU Logo -->
    <ImageView
        android:id="@+id/asuLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/logo_asu"
        android:scaleType="fitCenter"
    />

    <!-- App Name -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ASU FindMate"
        android:textColor="#142B59"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Lost &amp; Found"
        android:textColor="#536B87"
        android:textSize="23sp"
        android:gravity="center" />


    <ImageView
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:contentDescription="Search for lost items"
        android:src="@drawable/location" />
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="Search for lost items"
            android:src="@drawable/images" />




    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Welcome to ASU FindMate!\n

We're here to help you reconnect with your belongings and make our campus a better place.\n
Find it. Report it. Get it back!\n\n"
        android:textColor="#536B87"
        android:textSize="20sp"
        android:gravity="center"
        android:lineSpacingExtra="5dp" />


    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="20dp"
        android:text="Get Started  →"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#477FE0"
    />

</androidx.appcompat.widget.LinearLayoutCompat>

